    <string name="field_use_miuix_desc_enabled">يستخدم التطبيق حاليًا نمط التنقل والواجهة الخاص بـ \u2066MIUIX\u2069. عطّل هذا الخيار للعودة إلى \u2066Material 3\u2069.</string>
